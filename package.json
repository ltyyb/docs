{
  "name": "ltyyb-docs",
  "description": "六同音游部通用文档",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "docs:dev": "next dev",
    "docs:clean-dev": "node scripts/clean.mjs && next dev",
    "docs:build": "next build && node scripts/postbuild.mjs",
    "docs:preview": "node scripts/preview.mjs",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "check": "node scripts/check-build.mjs",
    "postinstall": "fumadocs-mdx"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "16.17.8",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.0.0",
    "remark-directive": "4.0.0"
  }
}
